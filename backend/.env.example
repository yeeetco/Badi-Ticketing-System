# Copy to .env and change the password to match your local PostgreSQL user.
DATABASE_URL=postgresql+psycopg://badi:badi_local_only@127.0.0.1:5432/badi
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Enable only when serving the application over HTTPS.
COOKIE_SECURE=false
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Production must use HTTPS origins, COOKIE_SECURE=true, and explicit deployed
# hosts without testserver or wildcards. Never publish this development server.
